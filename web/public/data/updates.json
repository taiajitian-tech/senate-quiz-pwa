  "items": [
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月27日：アプリから暗記カードを印刷",
      "type": "changed",
      "summary": "玄関モードのタイトルから「暗記カードを印刷」を開けます。参議院一般議員・参院役員・副大臣・政務官（衆参両院）を選択でき、初期設定はA4に20人の両面用です。表はカード内の余白なしの顔写真、裏は名前・ふりがな・役職等を表示します。長辺とじで切り分けた表裏が合うよう裏面を左右反転しています。参院現職全員を含める補完設定もあり、各議員の通し番号は表示しません。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月26日：玄関モードの副大臣表示を簡略化",
      "type": "changed",
      "summary": "玄関モードの学習・一覧の上段は「塩崎副大臣」のように苗字＋副大臣を表示します。フルネーム・ふりがな・兼務役職などの補足は従来どおり表示します。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月19日：大臣詳細の政党表示を修正",
      "type": "changed",
      "summary": "政党欄に役職が表示される問題を修正しました。大臣の所属会派は衆参の議員名簿から補完し、一覧・詳細・学習で役職を政党に流用しないようにしました。所属が確認できない場合は不明と表示します。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月19日：名簿・お知らせの点検と修正",
      "type": "changed",
      "summary": "副大臣・大臣政務官にも在任期間の終了した記録を除外する処理を適用し、データ検査でも混入を検出するようにしました。自動更新で変更がない場合も直近の変更内容をお知らせに保持します。新しいお知らせがない確認では未読通知を繰り返さず、手動のお知らせ追加もベルで通知します。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月19日：農林水産大臣の重複を修正",
      "type": "changed",
      "summary": "農林水産大臣は10月15日就任の武部新氏です。官邸の名簿に残る簗和生氏の在任履歴を現職として取り込んでいたため、現職大臣一覧から除外しました。自動更新でも在任期間の終了した記録を除外します。簗氏の衆議院議員としての掲載は継続します。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月10日：自動更新処理を修正",
      "type": "changed",
      "summary": "自動更新がデータ検査で停止する問題を修正しました。更新直前のデータと比較してお知らせを生成し、複数の更新処理が同時に上書きしないよう調整しました。公式サイトの取得に失敗したデータは直前の内容を保持し、取得できた両院の役員更新は継続します。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月10日：参議院・衆議院の役員を更新",
      "type": "changed",
      "summary": "参議院は2026年10月9日現在の公式役員一覧（33名）、衆議院は10月5日現在の公式役員一覧（29名）に更新しました。参議院の予算委員長は有村治子、議院運営委員長は藤川政人です。衆議院の予算委員長は齋藤健、議院運営委員長は坂本哲志です。交代した旧役員を除外し、新任の委員長・会長を反映しました。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "2026年10月10日：氏名・ふりがなの二重表示を修正",
      "type": "changed",
      "summary": "玄関モードの参議院役員・副大臣一覧で、ふりがなが重複する表示を修正しました。議長・副議長の氏名も1回だけ表示します。学習画面でも同じ表示規則を適用しました。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "副大臣・政務官を更新",
      "type": "changed",
      "summary": "2026年9月18日、第2次高市改造内閣の副大臣27人・政務官28人が決定しました。データを更新しました。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "第2次高市改造内閣が発足",
      "type": "changed",
      "summary": "2026年9月17日、第2次高市改造内閣が発足しました。23人の閣僚データ（読み仮名・画像・役職名）を更新しました。"
    },
    {
      "target": "notice",
      "targetLabel": "お知らせ",
      "name": "参議院役員の更新（第221回国会終了時）",
      "type": "changed",
      "summary": "第221回国会終了時の変更です。当時、議院運営委員長が欠員となり、皇室典範等特別委員長（松山政司）を一覧から削除しました。現在の役員は2026年10月9日現在の新名簿に更新済みです。"
    },
